# Optimised Dockerfile for Azure App Service (Linux container)
FROM python:3.11-slim

WORKDIR /app

# Install minimal system dependencies (curl for health check, poppler for PDF)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    poppler-utils \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies first (layer cache optimisation)
COPY requirements-azure.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-azure.txt

# Copy application code
COPY . .

# Create necessary runtime directories
RUN mkdir -p chroma_store DATASET/uploads models/rti_classifier \
    data/raw data/processed data/synthetic evaluation/results

# Set Python path
ENV PYTHONPATH=/app

# Expose port (Azure App Service injects PORT env variable)
EXPOSE 8000

# Health check (Azure uses PORT env variable, default 8000)
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=5 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

# Start FastAPI — Azure App Service sets $PORT automatically
CMD uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1
