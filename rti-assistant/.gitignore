# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Environment / secrets ──────────────────────────────────────────────────────
.env

# ── Testing & coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ── Type checkers ──────────────────────────────────────────────────────────────
.mypy_cache/

# ── Editors ────────────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log

# ── Temporary files ───────────────────────────────────────────────────────────
*.tmp
*.bak
*.swp
*~

# ── Project-specific ──────────────────────────────────────────────────────────

# SQLite database (generated at runtime)
rti_tracker.db

# ChromaDB vector store (rebuilt via setup.py / build_rag_index.py)
chroma_store/

# Fine-tuned model weights (can be retrained)
models/rti_classifier/*.bin
models/rti_classifier/*.safetensors
models/rti_classifier/*.pt

# Large dataset files (downloaded by setup.py)
DATASET/cic_orders/
DATASET/processed/
DATASET/uploads/
!DATASET/RTI-Act_English.pdf

# Evaluation output (regeneratable)
evaluation/results/*.json

# Jupyter (if used for exploration)
.ipynb_checkpoints/
